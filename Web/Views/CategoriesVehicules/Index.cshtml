@model IReadOnlyList<CategorieVehiculeDto>
@{
    ViewData["Title"] = "Catégories de véhicules";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Catégories de véhicules</h1>
    <a class="btn btn-primary" asp-action="Create">Nouvelle catégorie</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Aucune catégorie n'est enregistrée.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Libellé</th>
                    <th scope="col" class="text-end">Tarif journalier</th>
                    <th scope="col" class="text-end">Caution</th>
                    <th scope="col" class="text-end">Pénalité / jour de retard</th>
                    <th scope="col" class="text-end">Véhicules</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categorie in Model)
                {
                    <tr>
                        <td><strong>@categorie.Code</strong></td>
                        <td>@categorie.Libelle</td>
                        <td class="text-end">@categorie.TarifJournalier.ToString("N0") F CFA</td>
                        <td class="text-end">@categorie.Caution.ToString("N0") F CFA</td>
                        <td class="text-end">@categorie.PenaliteRetardParJour.ToString("N0") F CFA</td>
                        <td class="text-end">@categorie.NombreVehicules</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@categorie.Id">Détail</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@categorie.Id">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@categorie.Id">Supprimer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
